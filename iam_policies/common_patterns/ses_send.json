{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Statement1",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": [
        "arn:aws:ses:{Region}:{Account}:identity/{DomainOrEmail}"
      ],
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "{FromAddress}"
        }
      }
    }
  ]
}
