{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGetOnlyFromMyOrganization",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::{s3_bucket}/*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "o-abcd1234ef"
        }
      }
    }
  ]
}
