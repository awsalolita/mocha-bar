{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowServiceAssumeWithSourceGuard",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "{Account}"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:cloudtrail:{Region}:{Account}:trail/{TrailName}"
        }
      }
    }
  ]
}
