{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyCreatePrincipalWithoutBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateRole"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::{Account}:policy/{BoundaryPolicyName}"
        }
      }
    },
    {
      "Sid": "DenyRemovingOrChangingBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteUserPermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutUserPermissionsBoundary",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::{Account}:policy/{BoundaryPolicyName}"
        }
      }
    }
  ]
}
